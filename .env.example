# ==============================================================================
# SupportDesk Environment Configuration Template
# ==============================================================================

# Database Connection (Default PostgreSQL for Docker / AWS RDS)
DATABASE_URL=postgresql://supportdesk_user:supportdesk_password@localhost:5432/supportdesk_db

# Local SQLite Fallback (Optional for zero-setup local Python run)
# DATABASE_URL=sqlite:///./supportdesk.db

# PostgreSQL Container Credentials (used by docker-compose)
POSTGRES_USER=supportdesk_user
POSTGRES_PASSWORD=supportdesk_password
POSTGRES_DB=supportdesk_db

# SLA Hours per Priority
SLA_HOURS_CRITICAL=2
SLA_HOURS_HIGH=4
SLA_HOURS_MEDIUM=8
SLA_HOURS_LOW=24

# Application Configuration
APP_NAME=SupportDesk - Smart Technical Support Platform
APP_VERSION=1.0.0
